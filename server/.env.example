# 먼저 npm run setup을 실행하면 아래 설정과 임의의 JWT 비밀키를 자동 생성합니다.
# 직접 설정한다면 이 파일을 .env로 복사하고 실제 MySQL 연결 정보를 입력하세요.
HOST=127.0.0.1
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
# 실제 MySQL 계정명을 쓰세요. 20506은 MySQL 계정을 만들었을 때만 계정명입니다.
DB_USER=root
DB_PASSWORD=""
DB_NAME=together_20506
# 32자 이상의 임의 비밀키. npm run setup에서 자동 생성.
JWT_SECRET=""
